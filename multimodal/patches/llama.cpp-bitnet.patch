diff --git a/src/models/bitnet-moe.cpp b/src/models/bitnet-moe.cpp
new file mode 100644
index 000000000..e73242aab
--- /dev/null
+++ b/src/models/bitnet-moe.cpp
@@ -0,0 +1,238 @@
+#include "models.h"
+
+// BitNet-MoE: BitNet b1.58 blocks whose FFN is a top-k mixture of ternary experts.
+//
+// Per token x (after ffn_norm), with E experts and k = n_expert_used:
+//   p      = softmax(W_router x)                       (over all E)
+//   S      = top-k(p),  w_e = p_e / sum_{j in S} p_j   (Mixtral convention, norm_w = true)
+//   h_e    = relu(gate_e x)^2 * (up_e x)               [n_ff]
+//   h_e    = rms_norm(h_e) * ffn_sub_norm              (ONE sub-norm weight per layer, shared by all experts)
+//   out    = sum_{e in S} w_e * down_e h_e
+//
+// llm_graph_context::build_moe_ffn has no hook for a norm between the activation and the down projection, so the
+// routed FFN is built explicitly here with the same routing pieces (soft_max -> argsort_top_k -> get_rows -> norm).
+
+void llama_model_bitnet_moe::load_arch_hparams(llama_model_loader & ml) {
+    ml.get_key(LLM_KV_ATTENTION_LAYERNORM_RMS_EPS, hparams.f_norm_rms_eps);
+
+    // expert_count / expert_used_count are read by the generic loader (llama_model::load_hparams)
+    if (hparams.n_expert == 0 || hparams.n_expert_used == 0) {
+        throw std::runtime_error("bitnet-moe: expert_count and expert_used_count must be > 0");
+    }
+
+    switch (hparams.n_layer()) {
+        case 30: type = LLM_TYPE_2B; break; // upcycled from bitnet-b1.58-2B-4T (dense-equivalent size)
+        default: type = LLM_TYPE_UNKNOWN;
+    }
+}
+
+void llama_model_bitnet_moe::load_arch_tensors(llama_model_loader &) {
+    LLAMA_LOAD_LOCALS;
+
+    tok_embd = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD, "weight"), {n_embd, n_vocab}, 0);
+
+    // output (tied to tok_embd unless an explicit output.weight is present)
+    output_norm = create_tensor(tn(LLM_TENSOR_OUTPUT_NORM, "weight"), {n_embd}, 0);
+    output      = create_tensor(tn(LLM_TENSOR_OUTPUT,      "weight"), {n_embd, n_vocab}, TENSOR_NOT_REQUIRED);
+
+    for (int i = 0; i < n_layer; ++i) {
+        auto & layer = layers[i];
+
+        layer.attn_norm     = create_tensor(tn(LLM_TENSOR_ATTN_NORM,     "weight", i), {n_embd}, 0);
+        layer.attn_sub_norm = create_tensor(tn(LLM_TENSOR_ATTN_SUB_NORM, "weight", i), {n_embd}, 0);
+
+        // attention: identical to bitnet-b1.58 (optional per-tensor *_s scales for TL1/TL2-style exports)
+        layer.wq   = create_tensor(tn(LLM_TENSOR_ATTN_Q,   "weight", i), {n_embd, n_embd}, 0);
+        layer.wq_s = create_tensor(tn(LLM_TENSOR_ATTN_Q,   "scale",  i), {1}, TENSOR_NOT_REQUIRED);
+        layer.wk   = create_tensor(tn(LLM_TENSOR_ATTN_K,   "weight", i), {n_embd, n_embd_gqa}, 0);
+        layer.wk_s = create_tensor(tn(LLM_TENSOR_ATTN_K,   "scale",  i), {1}, TENSOR_NOT_REQUIRED);
+        layer.wv   = create_tensor(tn(LLM_TENSOR_ATTN_V,   "weight", i), {n_embd, n_embd_gqa}, 0);
+        layer.wv_s = create_tensor(tn(LLM_TENSOR_ATTN_V,   "scale",  i), {1}, TENSOR_NOT_REQUIRED);
+        layer.wo   = create_tensor(tn(LLM_TENSOR_ATTN_OUT, "weight", i), {n_embd, n_embd}, 0);
+        layer.wo_s = create_tensor(tn(LLM_TENSOR_ATTN_OUT, "scale",  i), {1}, TENSOR_NOT_REQUIRED);
+
+        layer.ffn_norm     = create_tensor(tn(LLM_TENSOR_FFN_NORM,     "weight", i), {n_embd}, 0);
+        layer.ffn_sub_norm = create_tensor(tn(LLM_TENSOR_FFN_SUB_NORM, "weight", i), {n_ff},   0);
+
+        // router: full precision
+        layer.ffn_gate_inp = create_tensor(tn(LLM_TENSOR_FFN_GATE_INP, "weight", i), {n_embd, n_expert}, 0);
+
+        // experts, stacked [n_in, n_out, n_expert]; I2_S stores one packed blob + 32-byte scale tail per expert
+        layer.ffn_gate_exps = create_tensor(tn(LLM_TENSOR_FFN_GATE_EXPS, "weight", i), {n_embd, n_ff,   n_expert}, 0);
+        layer.ffn_up_exps   = create_tensor(tn(LLM_TENSOR_FFN_UP_EXPS,   "weight", i), {n_embd, n_ff,   n_expert}, 0);
+        layer.ffn_down_exps = create_tensor(tn(LLM_TENSOR_FFN_DOWN_EXPS, "weight", i), {n_ff,   n_embd, n_expert}, 0);
+
+        // optional per-expert scales (float exports that store ternary codes {-1,0,1} + one scale per expert)
+        layer.ffn_gate_exps_s = create_tensor(tn(LLM_TENSOR_FFN_GATE_EXPS, "scale", i), {n_expert}, TENSOR_NOT_REQUIRED);
+        layer.ffn_up_exps_s   = create_tensor(tn(LLM_TENSOR_FFN_UP_EXPS,   "scale", i), {n_expert}, TENSOR_NOT_REQUIRED);
+        layer.ffn_down_exps_s = create_tensor(tn(LLM_TENSOR_FFN_DOWN_EXPS, "scale", i), {n_expert}, TENSOR_NOT_REQUIRED);
+    }
+}
