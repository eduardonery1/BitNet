diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index ec88ef29a..aaf6da67c 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -1695,6 +1695,146 @@ static void * incr_ptr_aligned(void ** p, size_t size, size_t align) {
     return ptr;
 }
 
+// I2_S mul_mat_id (BitNet-MoE ternary experts).
+// src0: [ne00, ne01, n_as] I2_S, stored as n_as consecutive 2D I2_S blobs of (ne00*ne01/4 + 32) bytes each; the
+//       f32 scale of expert a is at the start of its own 32-byte tail.
+// src1: [ne10, ne11, ne12] f32. Rows are gathered per expert and quantized to int8 (per-row absmax,
+//       quantize_row_i8_s) into one contiguous block per expert, so every expert runs as a dense I2_S x I8 GEMM
+//       (ggml_gemm_i2_i8_s) over its tokens. Gate/up (ne11 == 1) rows used by k experts are quantized k times.
+// Work split: each thread owns a contiguous range of output rows (src0 rows) for every selected expert, so each
+// selected expert's weights are streamed from memory once per call (decode is bandwidth-bound).
+static size_t ggml_mul_mat_id_i2s_wsize(const struct ggml_tensor * src0, const struct ggml_tensor * src1, const struct ggml_tensor * ids) {
+    const int64_t n_ent = ids->ne[0]*ids->ne[1];
+    size_t cur = 0;
+    cur += n_ent*src1->ne[0] + sizeof(int64_t);                          // gathered int8 activations
+    cur += n_ent*(sizeof(float) + sizeof(int32_t)) + 2*sizeof(int64_t);  // act scales + sums
+    cur += 2*src0->ne[2]*sizeof(int64_t) + 2*sizeof(int64_t);           // matrix_row_counts + offsets
+    cur += src0->ne[2]*n_ent*sizeof(struct mmid_row_mapping) + sizeof(int64_t);
+    return cur;
+}
+
+static void ggml_compute_forward_mul_mat_id_i2s(
+        const struct ggml_compute_params * params,
+              struct ggml_tensor * dst) {
+
+    const struct ggml_tensor * src0 = dst->src[0];
+    const struct ggml_tensor * src1 = dst->src[1];
+    const struct ggml_tensor * ids  = dst->src[2];
+
+    GGML_TENSOR_BINARY_OP_LOCALS
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    GGML_ASSERT(src0->type == GGML_TYPE_I2_S);
+    GGML_ASSERT(src1->type == GGML_TYPE_F32);
+    GGML_ASSERT(nb10 == sizeof(float));
+    GGML_ASSERT(nb0 == sizeof(float));
+    GGML_ASSERT(ne03 == 1 && ne13 == 1);
+    GGML_ASSERT(ne00 % 128 == 0);
+
+    const int     n_ids = ids->ne[0]; // n_expert_used
+    const int     n_as  = ne02;       // n_expert
+    const int64_t n_ent = ids->ne[0]*ids->ne[1];
+
+    void * wdata_cur = params->wdata;
+    int8_t  * qact       = incr_ptr_aligned(&wdata_cur, n_ent*ne10, sizeof(int64_t));
+    float   * act_scales = incr_ptr_aligned(&wdata_cur, n_ent*sizeof(float), sizeof(int64_t));
+    int32_t * act_sums   = incr_ptr_aligned(&wdata_cur, n_ent*sizeof(int32_t), sizeof(int64_t));
+    int64_t * matrix_row_counts = incr_ptr_aligned(&wdata_cur, n_as*sizeof(int64_t), sizeof(int64_t));
+    int64_t * matrix_row_offs   = incr_ptr_aligned(&wdata_cur, n_as*sizeof(int64_t), sizeof(int64_t));
+    struct mmid_row_mapping * matrix_rows =
+        incr_ptr_aligned(&wdata_cur, n_as*n_ent*sizeof(struct mmid_row_mapping), sizeof(int64_t));
+
+    GGML_ASSERT(params->wsize >= (size_t)((char *) wdata_cur - (char *) params->wdata));
+
+    if (ith == 0) {
+        memset(matrix_row_counts, 0, n_as*sizeof(int64_t));
+        for (int64_t iid1 = 0; iid1 < ids->ne[1]; ++iid1) {
+            for (int id = 0; id < n_ids; ++id) {
+                const int32_t i02 = *(const int32_t *) ((const char *) ids->data + iid1*ids->nb[1] + id*ids->nb[0]);
+                GGML_ASSERT(i02 >= 0 && i02 < n_as);
+                MMID_MATRIX_ROW(i02, matrix_row_counts[i02]) = (struct mmid_row_mapping) {id, iid1};
+                matrix_row_counts[i02] += 1;
+            }
+        }
+        int64_t off = 0;
+        for (int a = 0; a < n_as; ++a) {
+            matrix_row_offs[a] = off;
+            off += matrix_row_counts[a];
+        }
+    }
+
+    ggml_barrier(params->threadpool);
+
+    // gather + quantize: entry g = offs[a] + j holds the src1 row used by the j-th token routed to expert a
+    for (int a = 0; a < n_as; ++a) {
+        const int64_t cne1 = matrix_row_counts[a];
+        for (int64_t j = 0; j < cne1; ++j) {
+            const int64_t g = matrix_row_offs[a] + j;
+            if (g % nth != ith) {
+                continue;
+            }
+            const struct mmid_row_mapping rm = MMID_MATRIX_ROW(a, j);
+            const int64_t i11 = rm.i1 % ne11;
+            const int64_t i12 = rm.i2;
+            quantize_row_i8_s((const float *)((const char *) src1->data + i11*nb11 + i12*nb12),
+                              qact + g*ne10, ne10, act_scales + g, act_sums + g);
+        }
+    }
+
+    ggml_barrier(params->threadpool);
+
+    // static split of the output rows (multiples of 4 for the 4x4 GEMM tiles)
+    const int64_t blck = 4;
+    const int64_t nblk = (ne01 + blck - 1)/blck;
+    const int64_t ir0_start = MIN(ne01, ((ith    )*nblk/nth)*blck);
+    const int64_t ir0_end   = MIN(ne01, ((ith + 1)*nblk/nth)*blck);
+    if (ir0_start >= ir0_end) {
+        return;
+    }
+
+    const size_t a_packed = (size_t) ne00*ne01/4;
+    const size_t a_bytes  = a_packed + 32;
+    const size_t a_row    = (size_t) ne00/4;
+
+    enum { TILE_R = 64, TILE_C = 16 };
+    float tmp[TILE_R*TILE_C];
+
+    for (int cur_a = 0; cur_a < n_as; ++cur_a) {
+        const int64_t cne1 = matrix_row_counts[cur_a];
+        if (cne1 == 0) {
+            continue;
+        }
+
+        const uint8_t * src0_cur = (const uint8_t *) src0->data + cur_a*a_bytes;
+        float ws;
+        memcpy(&ws, src0_cur + a_packed, sizeof(float));
+
+        const int64_t g0 = matrix_row_offs[cur_a];
+
+        for (int64_t c0 = 0; c0 < cne1; c0 += TILE_C) {
+            const int64_t nc = MIN(TILE_C, cne1 - c0);
+            for (int64_t r0 = ir0_start; r0 < ir0_end; r0 += TILE_R) {
+                const int64_t nr = MIN(TILE_R, ir0_end - r0);
+                // tmp[c*nr + r] = dot(code row r0+r, int8 col g0+c0+c)
+                ggml_gemm_i2_i8_s(ne00, tmp, nr, src0_cur + r0*a_row, qact + (g0 + c0)*ne10, nc, nr);
+                for (int64_t c = 0; c < nc; ++c) {
+                    const int64_t g = g0 + c0 + c;
+                    const struct mmid_row_mapping rm = MMID_MATRIX_ROW(cur_a, c0 + c);
+                    float * dst_col = (float *) ((char *) dst->data + rm.i1*nb1 + rm.i2*nb2);
+                    // all-zero activation row: quantize_row_i8_s gives scale 0; the exact result is 0 (avoid 0/0)
+                    const float   post = act_scales[g] > 0.0f ? ws/act_scales[g] : 0.0f;
+                    const int32_t asum = act_sums[g];
+                    for (int64_t r = 0; r < nr; ++r) {
+                        dst_col[r0 + r] = (tmp[c*nr + r] - asum)*post;
+                    }
+                }
+            }
+        }
+    }
+}
+
 static void ggml_compute_forward_mul_mat_id(
         const struct ggml_compute_params * params,
               struct ggml_tensor * dst) {
@@ -1710,6 +1850,11 @@ static void ggml_compute_forward_mul_mat_id(
 
     const enum ggml_type type = src0->type;
 
+    if (type == GGML_TYPE_I2_S) {
+        ggml_compute_forward_mul_mat_id_i2s(params, dst);
+        return;
+    }
+
     const bool src1_cont = ggml_is_contiguous(src1);
 
     enum ggml_type    const vec_dot_type    = type_traits_cpu[type].vec_dot_type;
@@ -3017,6 +3162,10 @@ struct ggml_cplan ggml_graph_plan(
                         const struct ggml_tensor * ids = node->src[2];
                         const enum ggml_type vec_dot_type = type_traits_cpu[src0->type].vec_dot_type;
                         const int n_as = src0->ne[2];
+                        if (src0->type == GGML_TYPE_I2_S) {
+                            cur = ggml_mul_mat_id_i2s_wsize(src0, src1, ids);
+                            break;
+                        }
                         // src1
                         if (src1->type != vec_dot_type) {
                             cur += ggml_row_size(vec_dot_type, ggml_nelements(src1)) + sizeof(int64_t);
